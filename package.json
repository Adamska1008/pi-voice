{
  "name": "@earendil-works/pi-voice",
  "version": "0.2.0",
  "description": "Local speech-to-text for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi-voice.git"
  },
  "homepage": "https://github.com/earendil-works/pi-voice#readme",
  "bugs": {
    "url": "https://github.com/earendil-works/pi-voice/issues"
  },
  "files": [
    "src",
    "scripts/setup-wake.mjs",
    "docs/handsfree.md",
    "index.ts",
    "catalog/catalog.json",
    "catalog/recommendations.json",
    "models/silero-vad-v6.2-F32.gguf",
    "models/wake-keywords.txt",
    "models/README.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "transcription",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "wake:setup": "node scripts/setup-wake.mjs",
    "test": "npm run check && node scripts/run-tests.mjs",
    "prepublishOnly": "npm test",
    "recommendations:generate": "node scripts/generate-recommendations.mjs",
    "catalog:verify": "node scripts/catalog-metadata.mjs",
    "catalog:update-metadata": "node scripts/catalog-metadata.mjs --write"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@huggingface/gguf": "^0.4.6",
    "@types/node": "22.20.1",
    "typebox": "^1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.2.1",
    "@huggingface/hub": "2.15.0",
    "opencc-js": "^1.4.1",
    "sherpa-onnx-node": "1.13.8",
    "transcribe-cpp": "0.4.0"
  }
}
